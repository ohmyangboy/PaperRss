<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array><string>com.yangbukun.PaperRss.refresh</string></array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>PaperRss uses the local network only when you explicitly configure a local AI endpoint.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- RSS readers accept user-entered feeds, including legacy HTTP feeds
             and self-hosted RSSHub instances reachable by bare IP over port
             1200. This broad exception is intentional for the personal,
             user-driven reader. LLMService still rejects HTTP API endpoints by
             policy. Keep NSAllowsArbitraryLoads as the ONLY ATS key: pairing it
             with NSAllowsLocalNetworking makes ATS reject cleartext HTTP to
             IP-address hosts, breaking those user-configured feeds. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
