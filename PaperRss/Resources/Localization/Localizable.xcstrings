      }
    },
    "PaperRss 支持多账号并行与按需启用。本地订阅与 FreshRSS 远端订阅相互隔离，禁用账号不会删除本地数据或凭据。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaperRss supports multiple independently enabled accounts. Local subscriptions and FreshRSS subscriptions remain isolated, and disabling an account does not delete local data or credentials."
          }
        }
      }
    },
