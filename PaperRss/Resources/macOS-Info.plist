<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>PaperRss</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.news</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- RSS feeds are user-entered URLs and may be legacy HTTP endpoints
             (including self-hosted RSSHub instances reachable by bare IP over
             port 1200). LLMService still rejects HTTP API endpoints by policy.
             Keep NSAllowsArbitraryLoads as the ONLY ATS key: pairing it with
             NSAllowsLocalNetworking (or NSAllowsArbitraryLoadsInWebContent)
             makes App Transport Security reject cleartext HTTP to IP-address
             hosts, which is exactly what breaks those user-configured feeds. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
