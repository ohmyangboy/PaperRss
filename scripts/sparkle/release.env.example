# scripts/sparkle/release.env.example
# 复制为同目录 release.env（已被 .gitignore 排除）后填写实际值。
# 该文件只保存「引用名/公开材料」，绝不存放密码、私钥或 .p12。

# Developer Team ID（Developer ID 导出用）
PAPERRSS_TEAM_ID=

# 公证凭据二选一：
# A) keychain profile（需要 GUI 会话环境；沙箱/无钥匙串环境不可用）
#    xcrun notarytool store-credentials paperrss-notary --key <.p8> --key-id <ID> --issuer <UUID>
PAPERRSS_NOTARY_PROFILE=
# B) 直传 .p8 三元组（环境无关，推荐——Codex/CI 等沙箱环境也能公证）
PAPERRSS_NOTARY_KEY=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
PAPERRSS_NOTARY_KEY_ID=
PAPERRSS_NOTARY_ISSUER=

# Sparkle EdDSA 签名的 Keychain account（生产账户，勿与测试 paperrss-issue11-local 混用）
PAPERRSS_SIGNING_ACCOUNT=ed25519

# Sparkle 公钥（公开材料）。由 generate_keys 生成后把公钥填到这里；
# 私钥只存在于登录钥匙串，绝不写入任何文件。
PAPERRSS_SUPUBLIC_ED_KEY=

# Appcast 基地址（GitHub Pages）
PAPERRSS_APPCAST_BASE_URL=https://ohmyangboy.github.io/PaperRss/appcast

# 发布仓库坐标（Release 资产与 appcast 写入目标）
PAPERRSS_PUBLISH_REPO=ohmyangboy/PaperRss
PAPERRSS_APPCAST_REPO=ohmyangboy/PaperRss
PAPERRSS_APPCAST_BRANCH=main
